# Copy this file to .env in the same folder as docker-compose.yml
# and set values appropriate for your machine.

# Required: SQL Server SA password used by both sqlserver and init-db-image.
MSSQL_SA_PASSWORD=YourStrongPassword123

# Optional: host port mapped to SQL Server container port 1433.
HOST_SQL_PORT=11433

# Optional: database name created/seeded by init-db-image.
AGILITY_DB_NAME=AgilitySports
